FROM python:3.12-slim

WORKDIR /app

RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN apt-get update && \
    apt-get install -y --no-install-recommends fonts-liberation fonts-noto-color-emoji && \
    rm -rf /var/lib/apt/lists/*

# Install browsers into a shared path. Root-layer `playwright install` defaults to /root/.cache;
# runtime uses USER appuser (HOME=/app) which expects /app/.cache — Chromium was missing at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN mkdir -p /opt/ms-playwright && \
    playwright install chromium --with-deps || playwright install chromium

COPY . .

RUN mkdir -p /app/screenshots /app/resumes && \
    chown -R appuser:appuser /app /opt/ms-playwright

USER appuser

CMD ["arq", "app.workers.job_worker.JobWorkerSettings"]
