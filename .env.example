# Backend
# Railway: reference Postgres DATABASE_URL or omit; a blank DATABASE_URL var overrides defaults and fails startup.
DATABASE_URL=postgresql+asyncpg://jobedin:jobedin_dev@localhost:5432/jobedin
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
SENTRY_DSN_BACKEND=

# Clerk (https://dashboard.clerk.com — use one Development instance locally, Production in prod)
#
# Backend validates bearer tokens via JWKS (required when BYPASS_AUTH is false).
# Copy the JWKS URL from Clerk Dashboard → API Keys (same Clerk instance as the keys below).
CLERK_JWKS_URL=
#
# Secret + publishable keys for the SAME instance (Development or Production).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
#
# Official Clerk CLI (e.g. brew install clerk/stable/clerk). From repository root:
#   cd frontend && clerk link && clerk env pull --file .env.local && clerk doctor
# Production secrets for Next.js:
#   cd frontend && clerk env pull --instance prod --file .env.production.local
#
# Deploy checklist: Clerk Production instance → copy keys → Vercel env for the Next app;
# Railway/backend host gets CLERK_JWKS_URL + keys above. Set CORS_ORIGINS to your live
# frontend origin(s), comma-separated. In Clerk Dashboard → Domains / allowed origins,
# add your production URL.

# LinkedIn credential encryption
ENCRYPTION_KEY=

# AI Models
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Job discovery API sources
# JSearch (RapidAPI jsearch.p.rapidapi.com): set JSEARCH_API_KEY and/or RAPIDAPI_KEY (same value; both read for one effective key).
JSEARCH_API_KEY=
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Reed (reed.co.uk REST): plain API key — encoded as Basic automatically. Optional fallback: reuse RAPIDAPI_KEY/JSEARCH_API_KEY only if valid for Reed.
REED_API_KEY=
# Override if you already have a full Basic token (legacy deployments).
REED_BASIC_TOKEN=
# Optional Remotive.io key (public jobs API); source is skipped while listed in DISABLED_API_SOURCES.
REMOTIVE_API_KEY=
# Comma-separated source ids omitted from implicit discovery (Discover with no explicit sources uses active_api_sources).
DISABLED_API_SOURCES=remotive

# AWS S3 (resume uploads + generated PDFs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_RESUME_UPLOAD_PREFIX=resumes/uploads
S3_RESUME_GENERATED_PREFIX=resumes/generated
S3_COVER_LETTER_PREFIX=cover-letters/generated

# CORS (production: https://your-frontend-domain, comma-separated list allowed)
CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js root is frontend/; local dev often uses frontend/.env.local via clerk env pull)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN_FRONTEND=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
# Clerk Core 3+ (SDK v5+): use FALLBACK_REDIRECT, not AFTER_SIGN_* (legacy; ignored).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
